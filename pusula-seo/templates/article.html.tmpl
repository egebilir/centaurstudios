<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{meta_description}}">
    <meta name="author" content="Centaur Studios">
    <meta name="robots" content="index, follow">

    <!-- Open Graph -->
    <meta property="og:title" content="{{og_title}}">
    <meta property="og:description" content="{{meta_description}}">
    <meta property="og:type" content="article">
    <meta property="og:url" content="{{canonical_url}}">
    <meta property="og:image" content="{{og_image_url}}">
    <meta property="og:locale" content="tr_TR">
    <meta property="article:published_time" content="{{published_date}}">
    <meta property="article:modified_time" content="{{updated_date}}">
    <meta property="article:section" content="{{cluster_name}}">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{og_title}}">
    <meta name="twitter:description" content="{{meta_description}}">
    <meta name="twitter:image" content="{{og_image_url}}">

    <title>{{seo_title}}</title>

    <link rel="icon" type="image/png" href="{{{root_prefix}}}assets/images/apps/pusula.png">
    <link rel="apple-touch-icon" href="{{{root_prefix}}}assets/images/apps/pusula.png">
    <link rel="canonical" href="{{canonical_url}}">

    <link rel="stylesheet" href="{{{root_prefix}}}css/style.css">
    <link rel="stylesheet" href="{{{root_prefix}}}css/pusula.css">
    <link rel="stylesheet" href="{{{root_prefix}}}css/pusula-blog.css">

    <!-- Structured Data -->
    <script type="application/ld+json">{{{article_schema_json}}}</script>
    <script type="application/ld+json">{{{faq_schema_json}}}</script>
    <script type="application/ld+json">{{{breadcrumb_schema_json}}}</script>
</head>
<body>
    <canvas class="stars-canvas" id="starsCanvas"></canvas>

    <nav class="nav" id="mainNav">
        <div class="container nav-inner">
            <a href="{{{pusula_prefix}}}index.html" class="nav-logo">
                <img src="{{{root_prefix}}}assets/images/apps/pusula.png" alt="Pusula">
                <span>Pusula</span>
            </a>
            <div class="nav-links" id="navLinks">
                <a href="{{{pusula_prefix}}}blog/">Blog</a>
                <a href="{{{cluster_hub_relative}}}">{{cluster_name}}</a>
                <a href="{{{pusula_prefix}}}index.html#features">Uygulama</a>
                <a href="#" class="js-store-link pusula-btn pusula-btn-primary" style="padding: 8px 20px; font-size: 0.85rem;" data-slug="{{slug}}" data-cluster="{{cluster}}">İndir</a>
            </div>
            <button class="nav-menu-btn" id="menuBtn" aria-label="Menüyü aç/kapat">
                <span></span><span></span><span></span>
            </button>
        </div>
    </nav>

    <main class="pusula-article-page">
        <nav class="container pusula-breadcrumbs" aria-label="breadcrumb">
            <a href="{{{pusula_prefix}}}index.html">Pusula</a>
            <span class="sep">/</span>
            <a href="{{{pusula_prefix}}}blog/">Blog</a>
            <span class="sep">/</span>
            <a href="{{{cluster_hub_relative}}}">{{cluster_name}}</a>
            <span class="sep">/</span>
            <span aria-current="page">{{title}}</span>
        </nav>

        <article class="pusula-article">
            <header class="pusula-article-header">
                <div class="pusula-content-type-badge">{{content_type_label}}</div>
                <h1>{{title}}</h1>
                <p class="pusula-article-dek">{{dek}}</p>
                <p class="pusula-article-meta">Güncellenme: {{updated_date_display}}</p>
            </header>

            <div class="pusula-prose">
{{{body_html}}}
            </div>

            <section class="pusula-faq" aria-label="Sık Sorulan Sorular">
                <h2>Sık Sorulan Sorular</h2>
{{{faq_html}}}
            </section>

            <section class="pusula-cta-band">
                <p>{{cta_text}}</p>
                <div class="card-actions" style="justify-content: center;">
                    <a href="{{{app_store_url}}}" class="store-badge" data-slug="{{slug}}" data-cluster="{{cluster}}" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
                        App Store
                    </a>
                    <a href="{{{play_store_url}}}" class="store-badge" data-slug="{{slug}}" data-cluster="{{cluster}}" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.61 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.5,12.92 20.16,13.19L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/></svg>
                        Google Play
                    </a>
                </div>
            </section>

            <section class="pusula-related" aria-label="İlgili İçerikler">
                <h2>İlgili İçerikler</h2>
                <div class="pusula-related-grid">
{{{related_html}}}
                </div>
            </section>
        </article>
    </main>

    <footer class="footer" id="footer">
        <div class="container">
            <div class="footer-inner">
                <div class="footer-brand">
                    <div class="nav-logo">
                        <img src="{{{root_prefix}}}assets/images/apps/pusula.png" alt="Pusula">
                        <span>Pusula</span>
                    </div>
                    <p>Pusula, Centaur Studios tarafından geliştirilen bir manevi yol arkadaşı uygulamasıdır.</p>
                </div>
                <div class="footer-links-group">
                    <div class="footer-col">
                        <h4>Yasal</h4>
                        <ul>
                            <li><a href="{{{pusula_prefix}}}privacy-policy.html">Gizlilik Politikası</a></li>
                            <li><a href="{{{pusula_prefix}}}terms-of-use.html">Kullanım Şartları</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Stüdyo</h4>
                        <ul>
                            <li><a href="{{{pusula_prefix}}}index.html">Pusula Ana Sayfa</a></li>
                            <li><a href="mailto:support@centaurstudios.online">support@centaurstudios.online</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <div class="footer-copyright">© 2026 Centaur Studios. Tüm hakları saklıdır.</div>
            </div>
        </div>
    </footer>

    <div class="pusula-toast" id="pusulaToast"></div>

    <div class="pusula-sticky-cta" id="pusulaStickyCta">
        <div class="pusula-sticky-cta-inner">
            <span class="pusula-sticky-cta-text">🧭 Pusula'yı ücretsiz keşfet</span>
            <a href="#" class="js-store-link pusula-sticky-cta-btn" data-slug="{{slug}}" data-cluster="{{cluster}}">İncele</a>
        </div>
    </div>

    <script src="{{{root_prefix}}}js/main.js"></script>
    <script src="{{{root_prefix}}}js/pusula.js"></script>
    <script src="{{{root_prefix}}}js/pusula-analytics.js"></script>
</body>
</html>

# Copy this file to .env for local testing. Never commit .env — it is gitignored.
# In production (the cloud Routine), these are set as environment variables on
# the Routine's environment config, not committed here either.

# --- Telegram (required for the AI assistant) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Google Search Console (Phase 3 — leave blank until the property + service account exist) ---
# Paste the full service-account JSON key as a single-line string, or a path to the key file.
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=https://centaurstudios.online/

# --- GA4 Data API (Phase 3) ---
GA4_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=

# --- PostHog API (Phase 3 — separate from the client-side snippet key) ---
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://eu.posthog.com

# --- Telegram webhook accelerator (only needed if deploying the optional Cloudflare Worker) ---
TELEGRAM_WEBHOOK_SECRET=
GITHUB_CONTENTS_TOKEN=
